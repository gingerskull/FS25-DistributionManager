<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer"/>
    <Bitmap profile="dialogFullscreenBg" id="dialogBg"/>
    <GuiElement profile="dm_distributionDialogBg" id="dialogElement">
        <ThreePartBitmap profile="fs25_dialogBgMiddle"/>
        <ThreePartBitmap profile="fs25_dialogBgTop"/>
        <ThreePartBitmap profile="fs25_dialogBgBottom"/>
        <GuiElement profile="fs25_dialogContentContainer">
            <Text profile="dialogTitle" text="" id="dialogTitleElement" position="0px -30px"/>
            <Text profile="dialogText" text="" id="modeText" position="0px -70px"/>

            <Bitmap profile="dm_distributionHeaderBox" id="tableHeaderBox">
                <Text profile="dm_distributionHeader" position="10px 2px" size="340px 32px" text="$l10n_dm_productionColumn"/>
                <Text profile="dm_distributionHeaderRight" position="360px 2px" size="200px 32px" text="$l10n_dm_destinationsColumn"/>
                <Text profile="dm_distributionHeaderRight" position="570px 2px" size="100px 32px" text="$l10n_dm_modeColumn"/>
                <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px"/>
            </Bitmap>

            <SmoothList profile="dm_distributionList" id="destinationsList" focusInit="onOpen">
                <ListItem profile="dm_distributionListItem">
                    <Text profile="dm_distributionRowCell" position="10px 0px" size="340px 32px" name="name"/>
                    <Text profile="dm_distributionRowCellRight" position="360px 0px" size="200px 32px" name="status"/>
                    <Text profile="dm_distributionRowCellRight" position="570px 0px" size="100px 32px" name="enabled"/>
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="dm_distributionSliderBox">
                <Slider profile="fs25_listSlider" dataElementId="destinationsList"/>
            </ThreePartBitmap>
        </GuiElement>
        <BoxLayout profile="fs25_dialogButtonBox" id="buttonsPC">
            <Button profile="buttonOK" text="Toggle Destination" onClick="onClickToggleEnabled" id="toggleEnabledButton"/>
            <Button profile="buttonOK" text="Toggle Mode" onClick="onClickToggleMode" id="toggleModeButton"/>
            <Bitmap profile="fs25_dialogButtonBoxSeparator"/>
            <Button profile="buttonOK" text="$l10n_button_ok" onClick="onClickOk" id="yesButton"/>
            <Bitmap profile="fs25_dialogButtonBoxSeparator"/>
            <Button profile="buttonBack" text="$l10n_button_back" onClick="onClickBack" id="noButton"/>
        </BoxLayout>
    </GuiElement>
    <GUIProfiles>
        <Profile name="dm_distributionDialogBg" extends="fs25_dialogBg">
            <size value="750px 600px"/>
        </Profile>
        <Profile name="dm_distributionHeaderBox" extends="emptyPanel" with="anchorTopStretchingX">
            <size value="100% 40px"/>
            <position value="0px -150px"/>
            <imageColor value="0 0 0 0.35"/>
            <flowDirection value="horizontal"/>
            <wrapAround value="true"/>
        </Profile>
        <Profile name="dm_distributionHeader" extends="baseReference">
            <size value="150px 32px"/>
            <imageColor value="0 0 0 0"/>
            <textSize value="14px"/>
            <textBold value="true"/>
            <textUpperCase value="true"/>
            <textColor value="$preset_colorWhite_50"/>
            <textAlignment value="left"/>
            <textDisabledColor value="$preset_colorDisabled"/>
        </Profile>
        <Profile name="dm_distributionHeaderRight" extends="dm_distributionHeader">
            <textAlignment value="right"/>
        </Profile>
        <Profile name="dm_distributionList" extends="emptyPanel" with="anchorTopLeft">
            <position value="0px -190px"/>
            <size value="700px 300px"/>
        </Profile>
        <Profile name="dm_distributionListItem" extends="baseReference" with="anchorTopStretchingX">
            <height value="36px"/>
            <imageColor value="0.1 0.1 0.1 0.3"/>
            <imageSelectedColor value="0.0227 0.5346 0.8519 0.5"/>
        </Profile>
        <Profile name="dm_distributionRowCell" extends="baseReference" with="anchorStretchingYLeft">
            <size value="150px 32px"/>
            <textSize value="14px"/>
            <textColor value="$preset_fs25_colorMainLight"/>
            <textSelectedColor value="$preset_colorWhite"/>
            <textAlignment value="left"/>
        </Profile>
        <Profile name="dm_distributionRowCellRight" extends="dm_distributionRowCell">
            <textAlignment value="right"/>
        </Profile>
        <Profile name="dm_distributionSliderBox" extends="baseReference" with="anchorTopRight">
            <position value="700px -190px"/>
            <size value="20px 300px"/>
        </Profile>
    </GUIProfiles>
</GUI>
