<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer"/>
    <Bitmap profile="dialogFullscreenBg" id="dialogBg"/>
    <GuiElement profile="dm_distributionDialogBg" id="dialogElement">
        <ThreePartBitmap profile="fs25_dialogBgMiddle"/>
        <ThreePartBitmap profile="fs25_dialogBgTop"/>
        <ThreePartBitmap profile="fs25_dialogBgBottom"/>
        <GuiElement profile="fs25_dialogContentContainer">
            <GuiElement profile="dm_distributionHeaderPanel">
                <Bitmap profile="dm_distributionHeaderIconBg">
                    <Bitmap profile="dm_distributionProdIcon" id="productionIcon"/>
                </Bitmap>
                <Bitmap profile="dm_distributionFillTypeIcon" id="fillTypeIcon"/>
                <Text profile="dm_distributionTitle" text="" id="dialogTitleElement"/>
                <Text profile="dm_distributionModeText" text="" id="modeText"/>
            </GuiElement>

            <GuiElement profile="dm_distributionHeaderBox" id="tableHeaderBox">
                <Text profile="dm_distributionHeader" position="58px 0px" size="300px 34px" text="$l10n_dm_destinationColumn"/>
                <Text profile="dm_distributionHeader" position="365px 0px" size="300px 34px" text="$l10n_dm_fillColumn"/>
                <Text profile="dm_distributionHeaderRight" position="670px 0px" size="120px 34px" text="$l10n_dm_percentColumn"/>
                <Text profile="dm_distributionHeaderRight" position="805px 0px" size="135px 34px" text="$l10n_dm_statusColumn"/>
                <Text profile="dm_distributionHeaderRight" position="955px 0px" size="150px 34px" text="$l10n_dm_manualColumn"/>
            </GuiElement>

            <SmoothList profile="dm_distributionList" id="destinationsList" focusInit="onOpen">
                <ListItem profile="dm_distributionListItem">
                    <Bitmap profile="dm_distributionRowIcon" name="icon"/>
                    <Text profile="dm_distributionRowName" position="58px 0px" size="300px 48px" name="name" textLayoutMode="scrolling"/>
                    <ThreePartBitmap profile="dm_distributionFillBarBg" name="fillBarBg"/>
                    <ThreePartBitmap profile="dm_distributionFillBar" name="fillBar"/>
                    <Text profile="dm_distributionVolumeText" name="volume"/>
                    <Text profile="dm_distributionPercentText" name="percent"/>
                    <Text profile="dm_distributionStatusText" name="enabled"/>
                    <Text profile="dm_distributionManualText" name="manual"/>
                </ListItem>
            </SmoothList>
            <Text profile="dm_distributionEmptyText" text="$l10n_dm_noDestinations" id="noDestinationsText" visible="false"/>
            <ThreePartBitmap profile="dm_distributionSliderBox" id="destinationsSliderBox">
                <Slider profile="fs25_listSlider" size="6px 410px" dataElementId="destinationsList" id="destinationsSlider"/>
            </ThreePartBitmap>
        </GuiElement>
        <BoxLayout profile="fs25_dialogButtonBox" id="buttonsPC">
            <Button profile="buttonOK" text="$l10n_dm_buttonToggleEnabled" onClick="onClickToggleEnabled" id="toggleEnabledButton"/>
            <Button profile="buttonOK" text="$l10n_dm_buttonToggleMode" onClick="onClickToggleMode" id="toggleModeButton"/>
            <Bitmap profile="fs25_dialogButtonBoxSeparator"/>
            <Button profile="buttonOK" text="$l10n_button_ok" onClick="onClickOk" id="yesButton"/>
            <Bitmap profile="fs25_dialogButtonBoxSeparator"/>
            <Button profile="buttonBack" text="$l10n_button_back" onClick="onClickBack" id="noButton"/>
        </BoxLayout>
    </GuiElement>
    <GUIProfiles>
        <Profile name="dm_distributionDialogBg" extends="fs25_dialogBg">
            <size value="1180px 720px"/>
        </Profile>
        <Profile name="dm_distributionHeaderPanel" extends="emptyPanel" with="anchorTopCenter">
            <size value="1120px 92px"/>
            <position value="0px -30px"/>
        </Profile>
        <Profile name="dm_distributionHeaderIconBg" extends="baseReference" with="anchorMiddleLeft">
            <size value="68px 68px"/>
            <position value="0px 0px"/>
            <imageSliceId value="gui.icon_ingameMenu_statistics"/>
            <imageColor value="$preset_colorWhite"/>
        </Profile>
        <Profile name="dm_distributionProdIcon" extends="baseReference" with="anchorMiddleCenter">
            <size value="58px 58px"/>
            <imageColor value="$preset_colorWhite"/>
        </Profile>
        <Profile name="dm_distributionFillTypeIcon" extends="baseReference" with="anchorMiddleLeft">
            <size value="44px 44px"/>
            <position value="82px 0px"/>
            <imageSliceId value="noSlice"/>
            <imageColor value="$preset_colorWhite"/>
        </Profile>
        <Profile name="dm_distributionTitle" extends="dialogTitle" with="anchorMiddleLeft">
            <size value="720px 54px"/>
            <position value="140px 0px"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="middle"/>
            <textSize value="26px"/>
            <textUpperCase value="true"/>
            <textBold value="true"/>
        </Profile>
        <Profile name="dm_distributionModeText" extends="baseReference" with="anchorMiddleRight">
            <size value="340px 54px"/>
            <position value="0px -2px"/>
            <textAlignment value="right"/>
            <textVerticalAlignment value="middle"/>
            <textSize value="16px"/>
            <textUpperCase value="true"/>
            <textColor value="$preset_fs25_colorMainLight"/>
            <textBold value="true"/>
        </Profile>
        <Profile name="dm_distributionHeaderBox" extends="baseReference" with="anchorTopCenter">
            <size value="1120px 44px"/>
            <position value="0px -125px"/>
            <imageColor value="0 0 0 0.35"/>
        </Profile>
        <Profile name="dm_distributionHeader" extends="baseReference">
            <size value="150px 32px"/>
            <imageColor value="0 0 0 0"/>
            <textSize value="15px"/>
            <textBold value="true"/>
            <textUpperCase value="true"/>
            <textColor value="$preset_colorWhite_50"/>
            <textAlignment value="left"/>
            <textDisabledColor value="$preset_colorDisabled"/>
        </Profile>
        <Profile name="dm_distributionHeaderRight" extends="dm_distributionHeader">
            <textAlignment value="right"/>
        </Profile>
        <Profile name="dm_distributionList" extends="emptyPanel" with="anchorTopCenter">
            <position value="0px -170px"/>
            <size value="1120px 410px"/>
        </Profile>
        <Profile name="dm_distributionListItem" extends="baseReference" with="anchorTopStretchingX alternating">
            <height value="56px"/>
            <imageColor value="$preset_fs25_colorGrey"/>
            <imageSelectedColor value="$preset_fs25_colorMainHighlight"/>
            <alternateBackgroundColor value="$preset_fs25_colorGreyDark_50"/>
        </Profile>
        <Profile name="dm_distributionRowIcon" extends="baseReference" with="anchorMiddleLeft">
            <size value="36px 36px"/>
            <position value="10px 0px"/>
            <imageSliceId value="noSlice"/>
            <imageColor value="$preset_colorWhite"/>
        </Profile>
        <Profile name="dm_distributionRowName" extends="baseReference" with="anchorStretchingYLeft">
            <textSize value="15px"/>
            <textColor value="$preset_fs25_colorMainLight"/>
            <textSelectedColor value="$preset_fs25_colorMainDark"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="middle"/>
            <textUpperCase value="true"/>
            <textBold value="true"/>
        </Profile>
        <Profile name="dm_distributionFillBarBg" extends="baseReference" with="anchorMiddleLeft">
            <position value="365px 9px"/>
            <size value="290px 6px"/>
            <imageSliceId value="gui.progressbar_middle"/>
            <imageColor value="0 0 0 0.55"/>
            <startImageSize value="5px 0"/>
            <startImageSliceId value="gui.progressbar_left"/>
            <startImageColor value="0 0 0 0.55"/>
            <endImageSize value="5px 0"/>
            <endImageSliceId value="gui.progressbar_right"/>
            <endImageColor value="0 0 0 0.55"/>
        </Profile>
        <Profile name="dm_distributionFillBar" extends="baseReference" with="anchorMiddleLeft">
            <position value="365px 9px"/>
            <size value="1px 6px"/>
            <imageSliceId value="gui.progressbar_middle"/>
            <imageColor value="0.0227 0.5346 0.8519 0.95"/>
            <startImageSize value="5px 0"/>
            <startImageSliceId value="gui.progressbar_left"/>
            <startImageColor value="0.0227 0.5346 0.8519 0.95"/>
            <endImageSize value="5px 0"/>
            <endImageSliceId value="gui.progressbar_right"/>
            <endImageColor value="0.0227 0.5346 0.8519 0.95"/>
        </Profile>
        <Profile name="dm_distributionVolumeText" extends="baseReference" with="anchorStretchingYLeft">
            <position value="365px -8px"/>
            <size value="290px 24px"/>
            <textSize value="13px"/>
            <textColor value="$preset_colorWhite_50"/>
            <textSelectedColor value="$preset_fs25_colorMainDark"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="middle"/>
        </Profile>
        <Profile name="dm_distributionPercentText" extends="baseReference" with="anchorStretchingYLeft">
            <position value="670px 0px"/>
            <size value="120px 48px"/>
            <textSize value="15px"/>
            <textColor value="$preset_fs25_colorMainLight"/>
            <textSelectedColor value="$preset_fs25_colorMainDark"/>
            <textAlignment value="right"/>
            <textVerticalAlignment value="middle"/>
            <textBold value="true"/>
        </Profile>
        <Profile name="dm_distributionStatusText" extends="dm_distributionPercentText">
            <position value="805px 0px"/>
            <size value="135px 48px"/>
            <textUpperCase value="true"/>
        </Profile>
        <Profile name="dm_distributionManualText" extends="dm_distributionPercentText">
            <position value="955px 0px"/>
            <size value="150px 48px"/>
            <textSize value="13px"/>
            <textBold value="false"/>
            <textColor value="$preset_colorWhite_50"/>
        </Profile>
        <Profile name="dm_distributionEmptyText" extends="dialogText" with="anchorTopCenter">
            <position value="0px -285px"/>
            <size value="900px 40px"/>
            <textAlignment value="center"/>
            <textSize value="18px"/>
            <textColor value="$preset_colorWhite_50"/>
        </Profile>
        <Profile name="dm_distributionSliderBox" extends="fs25_listSliderBox" with="anchorTopCenter">
            <position value="566px -170px"/>
            <size value="12px 410px"/>
        </Profile>
    </GUIProfiles>
</GUI>
