<modDesc descVersion="108">
  <author>gingerskull</author>
  <version>1.0.0.0</version>
  <title>
    <en>Distribution Manager</en>
  </title>
  <description>
    <en>
      <![CDATA[Distribution Manager

Allows fine-grained control over how production outputs are distributed to other production facilities.

Features:
* New output mode: Manager — automatically distributes output to owned production points
* Auto Equalize mode: Balances fill levels across destinations with configurable tolerance
* Manual mode: Set custom percentages or caps per destination
* Global-aware distribution: Multiple sources pushing to the same destination coordinate naturally
* Overflow buffering: Excess output stays in source storage when destinations are full
* Full multiplayer support

]]>
    </en>
  </description>
  <iconFilename>icon_DistributionManager.dds</iconFilename>

  <multiplayer supported="true"/>
